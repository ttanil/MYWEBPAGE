    <script>
      removeAllProducts();
   
      function readAllData() {  
         const request = indexedDB.open('deviceDb', 1);  

         request.onsuccess = function(event) {  
            const db = event.target.result;  
            const transaction = db.transaction(['deviceSepetim'], 'readonly');  
            const objectStore = transaction.objectStore('deviceSepetim');  
            const getAllRequest = objectStore.getAll();  

            getAllRequest.onsuccess = function() {  
                  const allData = getAllRequest.result.map(item => {  
                     return {  
                        idDb: item.id,  
                        productNameDb: item.productNameDb,  
                        productImgDb: item.productImgDb,  
                        productPriceDb: item.productPriceDb,  
                        quantityDb: item.quantityDb  
                     };  
                  });  
                  removeAllProducts(); // İlk olarak önce tüm ürünleri kaldır  

                  if (allData.length !== 0) {  
                     // Eğer veritabanında ürün varsa, ekle  
                     for (let i = 0; i < allData.length; i++) {  
                        console.log(`Ürün ${i + 1} id:`, allData[i].idDb);  
                        addProduct(i, allData[i].productImgDb, allData[i].productNameDb, allData[i].productPriceDb,  
                                    allData[i].quantityDb, allData[i].idDb);  
                     }   
                  } else {
                     const productContainer = document.getElementById('sold-container');  
                     productContainer.innerHTML = '<p style="font-family:Poppins, sans-serif; font-weight: 200; font-size: 16px;">Hiç ürün yok. Lütfen ürün ekleyin.</p>';  
                  }  
            };  

            getAllRequest.onerror = function(event) {  
                  //console.error('Veri okuma hatası:', event.target.error);  
            };  
         };  

         request.onerror = function(event) {  
            //console.error('Veritabanı açma hatası:', event.target.error);  
         };  
      }  
      readAllData();

      function removeProductById(id) {  
         const request = indexedDB.open('deviceDb', 1);  

         request.onsuccess = function(event) {  
            const db = event.target.result;  
            const transaction = db.transaction(['deviceSepetim'], 'readwrite');  
            const objectStore = transaction.objectStore('deviceSepetim');  
            const deleteRequest = objectStore.delete(id);

            deleteRequest.onsuccess = function() {  
                  //console.log(`Ürün ID ${id} başarıyla silindi.`);  
                  readAllData();
            };  

            deleteRequest.onerror = function(event) {  
                  //console.error('Silme hatası:', event.target.error);  
            };  
         };  

         request.onerror = function(event) {  
            //console.error('Veritabanı açma hatası:', event.target.error);  
         };  
      }
      function updateProductById(id, productName, productImg, productPrice, quantity) {  
         const request = indexedDB.open('deviceDb', 1);  

         request.onsuccess = function(event) {  
            const db = event.target.result;  
            const transaction = db.transaction(['deviceSepetim'], 'readwrite');  
            const objectStore = transaction.objectStore('deviceSepetim');  
            
            const getRequest = objectStore.get(id);  

            getRequest.onsuccess = function() {  
                  const item = getRequest.result;  
                  if (item) {  
                     item.productNameDb = productName;  
                     item.productImgDb = productImg;  
                     item.productPriceDb = productPrice;  
                     item.quantityDb = quantity;  

                     const updateRequest = objectStore.put(item);  

                     updateRequest.onsuccess = function() {  
                        //console.log(`Ürün ID ${id} başarıyla güncellendi.`);  
                        readAllData();
                     };  

                     updateRequest.onerror = function(event) {  
                        //console.error('Güncelleme hatası:', event.target.error);  
                     };  
                  } else {  
                     //console.log(`ID ${id} ile eşleşen ürün bulunamadı.`);  
                  }  
            };  

            getRequest.onerror = function(event) {  
               //console.error('Veri okuma hatası:', event.target.error);  
            };  
         };  

         request.onerror = function(event) {  
            //console.error('Veritabanı açma hatası:', event.target.error);  
         };  
      }



      function removeAllProducts() {  
         const productContainer = document.getElementById('sold-container');  
         while (productContainer.firstChild) {  
            productContainer.removeChild(productContainer.firstChild);
         }  
      }
      

      function addProduct(number, imageSrc, productName, price,quantity, id) {  
         const productContainer = document.getElementById('sold-container');

         // Yeni bir ürün div'i  
         const newProduct = document.createElement('div');  
         newProduct.className = 'sold1';  

         newProduct.innerHTML = `  
            <img src="${imageSrc}" alt="${productName}" id="${productName}">  
            <div class="name-price">  
                  <h4 class="sold-name">${productName}</h4>  
                  <span class="price-area">  
                     <h5 class="sold-price">${price}</h5>  
                     <svg xmlns="http://www.w3.org/2000/svg" id="urun-price-sign" data-name="Layer 1" viewBox="0 0 24 24" width="5" height="20" class="tlSign">  
                        <path d="M20.5,11c-.829,0-1.5,.672-1.5,1.5,0,4.687-3.813,8.5-8.5,8.5-.827,0-1.5-.673-1.5-1.5v-5.403l6.013-2.186c.778-.283,1.18-1.145,.897-1.923-.283-.779-1.144-1.181-1.922-.897l-4.987,1.814v-1.807l6.013-2.186c.778-.283,1.18-1.145,.897-1.923-.283-.779-1.144-1.181-1.922-.897l-4.987,1.814V1.5c-.034-1.972-2.967-1.971-3,0V6.994l-3.013,1.096c-.778,.283-1.18,1.145-.897,1.923,.282,.787,1.164,1.177,1.922,.897l1.987-.723v1.807l-3.013,1.096c-.778,.283-1.18,1.145-.897,1.923,.282,.787,1.164,1.177,1.922,.897l1.987-.723v4.312c0,2.481,2.019,4.5,4.5,4.5,6.341,0,11.5-5.159,11.5-11.5,0-.828-.671-1.5-1.5-1.5Z"/>  
                     </svg>  
                  </span>  
            </div>  
            <div class="quantity-sold1" id="quantitySold${number}">  
                  <h3 id="minusSold${number}">-</h3>  
                  <h2 id="quantityDisplay${number}">${quantity}</h2>  
                  <h2>kg</h2>  
                  <h3 id="plusSold${number}">+</h3>  
            </div>  
            <div class="trash">  
                  <img src="../img/user/trash.png" alt="trash" id="trash${number}">  
            </div>  
         `;   

         productContainer.appendChild(newProduct);  

         setupQuantityControl(number,id, productName, imageSrc, price);
         setupTrashControl(number,id);
         
      }  

      function setupQuantityControl(number,id, productName, productImg, productPrice) {  
         const plusButton = document.getElementById(`plusSold${number}`);  
         const minusButton = document.getElementById(`minusSold${number}`);  
         const quantityDisplay = document.getElementById(`quantityDisplay${number}`);  

         plusButton.addEventListener('click', function() {  
            let currentQuantity = parseFloat(quantityDisplay.textContent);  
            currentQuantity += 0.5;  
            quantityDisplay.textContent = currentQuantity;
            updateProductById(id, productName, productImg, productPrice, currentQuantity)
         });  

         minusButton.addEventListener('click', function() {  
            let currentQuantity = parseFloat(quantityDisplay.textContent);  
            currentQuantity -= 0.5;  
            if (currentQuantity < 0) {  
                  currentQuantity = 0;  
            }  
            quantityDisplay.textContent = currentQuantity;  
         });  
      }

      function setupTrashControl(number,id) {   
         const trashButton = document.getElementById(`trash${number}`);  
         
         trashButton.addEventListener('click', function() {  
            //console.log(`ID ${number} olan ürün silinecek.`);  
            removeProductById(id);  
         });  
      }  

    </script>
</body>
