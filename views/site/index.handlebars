   <script>  
      document.addEventListener('DOMContentLoaded', function() {  
         const hizli1Button = document.getElementById('hizliImg1');
         const hizli2Button = document.getElementById('hizliImg2');
         const hizli3Button = document.getElementById('hizliImg3');
         const hizli4Button = document.getElementById('hizliImg4');
         const hizli5Button = document.getElementById('hizliImg5');
         const hizli6Button = document.getElementById('hizliImg6');
         const hizli7Button = document.getElementById('hizliImg7');
         const hizli8Button = document.getElementById('hizliImg8');

         hizli1Button.addEventListener('click', function(event) {  
               const productIndex = 1;  
               const description = `Antrikot, et severlerin vazgeçilmezi olan, zengin lezzeti ve yumuşak dokusuyla damakları   
               şenlendiren bir kırmızı et seçeneğidir. Özenle seçilmiş, yüksek kaliteli sığır etinden elde edilen antrikot,   
               her lokmada mükemmel bir tat deneyimi sunar.`;
               handleProductClick(productIndex, description);  
         });  
         hizli2Button.addEventListener('click', function(event) {  
               const productIndex = 2;  
               const description = `Kasap Köfte, içerdiği kaliteli malzemelerle öne çıkan, yumuşak dokusu ve zengin lezzetiyle 
               damaklarda iz bırakan bir kırmızı et seçeneğidir.`;  
               handleProductClick(productIndex, description);  
         });  
         hizli3Button.addEventListener('click', function(event) {  
               const productIndex = 3;  
               const description = `Dana bonfile, hafif tatlı ve zengin bir lezzet profiline sahiptir.
               Dana bonfile, ızgara veya tavada mühürlenerek pişirildiğinde en iyi sonuçları verir. Orta derecede pişirilmesi önerilir, 
               böylece etin yumuşaklığı ve sulu yapısı korunur. Farklı baharatlar ve marinelerle zenginleştirerek, damak zevkinize
               uygun lezzetler yaratabilirsiniz. Yüksek kaliteli protein kaynağı olan dana bonfile, kas gelişimi ve onarımı için 
               gereklidir. Ayrıca demir, çinko ve B vitaminleri açısından zengindir, bu da bağışıklık sistemini güçlendirir.
               Dana bonfile, hem lezzeti hem de besin değeri ile sofralarınıza şıklık katacak bir üründür. Özel günlerde, 
               aile yemeklerinde veya misafirlerinize sunabileceğiniz en iyi seçeneklerden biridir. Kaliteli et arayışında olanlar 
               için mükemmel bir tercihtir.`;  
               handleProductClick(productIndex, description);  
         });  
         hizli4Button.addEventListener('click', function(event) {  
               const productIndex = 4;  
               const description = `Özenle dinlendirilmiş, düşük yağ oranı ve yüksek protein içeriği ile sağlıklı beslenmenin 
               lezzetli yolu: Dana kontrfile!`;  
               handleProductClick(productIndex, description);  
         });
         hizli5Button.addEventListener('click', function(event) {  
               const productIndex = 5;  
               const description = `İsteğinize göre az yağlı ya da çok yağlı olarak hazırlanır. Sipariş notunda belirtmeniz yeterli.`;  
               handleProductClick(productIndex, description);  
         });
         hizli6Button.addEventListener('click', function(event) {  
               const productIndex = 6;  
               const description = `Tavuk ürünlerimiz, en yüksek sağlık standartlarına uygun olarak üretilmektedir. Hijyenik koşullarda 
               hazırlanıp saklanmaktalardır. Yüksek protein içeriği ve düşük yağ oranıyla sağlıklı bir yaşam için mükemmel bir tercihtir. 
               Aile sofralarınızda hem lezzetli hem de besleyici bir seçenek sunarak sevdiklerinizin sağlığını ön planda tutar. 
               Tavuk etinin zengin besin değerleri, günlük protein ihtiyacınızı karşılamanıza yardımcı olur.`;  
               handleProductClick(productIndex, description);  
         });
         hizli7Button.addEventListener('click', function(event) {  
               const productIndex = 7;  
               const description = `Özenle hazırlanmış taze tavuk kanatları, özel soslarımızla buluşarak eşsiz bir tat deneyimi sunuyor. 
               Soslu kanatlarımız, hem atıştırmalık hem de ana yemek olarak mükemmel bir tercihtir.`;  
               handleProductClick(productIndex, description);  
         });
         hizli8Button.addEventListener('click', function(event) {  
               const productIndex = 8;  
               const description = `Kuzu kuşbaşı, mutfaklarınızda lezzetin doruklarına ulaşmanızı sağlayacak bir seçenektir. Taze ve 
               kaliteli kuzu etinden hazırlanan kuşbaşı, her yemeğe derin bir tat katarken, sağlıklı beslenme için de mükemmel bir 
               tercihtir. Sofralarınıza geleneksel ve modern tariflerle zenginlik katmaya hazır!`;  
               handleProductClick(productIndex, description);  
         });
         function handleProductClick(productIndex, description) {  
               const imageUrl = document.getElementById(`hizliImg${productIndex}`).src;
               const productName = document.querySelector(`.hizli-${productIndex}-name`).textContent;
               const price = document.querySelector(`.hizli-${productIndex}-price`).textContent;

               window.location.href = `/urun?product=${encodeURIComponent(productName)}&price=${encodeURIComponent(price)}
               &image=${encodeURIComponent(imageUrl)}&description=${encodeURIComponent(description)}`;  
         }  
      });  
   </script>

   <script>  
      const buttonIds = ['hizliBasket1', 'hizliBasket2', 'hizliBasket3', 'hizliBasket4', 'hizliBasket5', 
                        'hizliBasket6', 'hizliBasket7', 'hizliBasket8'];  

      buttonIds.forEach(id => {  
         const addButton = document.getElementById(id);
         if (addButton) {
            addButton.addEventListener('click', function() {  
               document.getElementById('myModalIndex').classList.remove('hidden');  
               document.getElementById('myModalIndex').classList.add('sekil');  
            });  
         }  
      });  

      function closeInfoMenu() {  
         document.getElementById('myModalIndex').classList.remove('sekil');  
         document.getElementById('myModalIndex').classList.add('hidden');  
      }  
   </script>

