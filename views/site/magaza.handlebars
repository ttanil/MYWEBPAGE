<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="stylesheet" href="../css/index.css">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" 
   integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" 
   crossorigin="anonymous" referrerpolicy="no-referrer" />
   <link rel="icon" href="/img/favicon/logo.png" type="image/png">
   <title>by Şükrü</title>
</head>
<body>
   <div class="topbar1">
      <div class="wrapper target">
         <h1>DOĞAL, TAZE VE ÖZENLE HAZIRLANMIŞ ET ÜRÜNLERİ</h1>
      </div>
   </div>

   <section>
      <section class="parallax-magaza">
         <div class="topbar2-magaza">
            <div class="wrapper target">
               <div class="left-magaza">
                  <i>kasapzakir</i>
               </div>
               <div class="center-magaza">
                  <a href="/">Anasayfa</a>
                  <a href="/magaza">Mağaza</a>
                  <a href="/hakkimizda">Hakkımızda</a>
               </div>
               <div class="right-magaza">
                  <span>
                     <div>

                        {{#if user}}
                        <img src="/img/user/circle-user.png" alt="user" id="circleUserIcon" style="cursor: pointer;">

                           <div id="dropdownMenu" style="display: none;"> 
                              <ul>  
                                 <li>Siparişlerim</li>  
                                 <li>Adresim</li>  
                                 <li>Cüzdanım</li>
                                 <li>İstek Listem</li>
                                 <li>Hesabım</li>
                                 <li>  
                                    <a href="./logout">Çıkış</a>  
                                 </li>  
                              </ul>  
                           </div>
                           <span>
                            <!--  <img src="/img/user/arrow.svg" alt="arrow" id="arrowIcon">-->
                           
                           </span>
                        {{/if}}
                           
                        {{#unless user}}
                           <span class="giris">
                              <a href="/register">Giriş</a>
                           </span>
                        {{/unless}}
                        

                     </div>  
                  </span>
                  
                  <span class="relative-magaza inline-block">  
                     <a href="/sepetim">  
                        <img src="/img/user/basket-shopping-simple.png" alt="basket" id="basketIcon">  
                        <span id="itemCount" class="absolute-magaza top-0-magaza right-0-magaza bg-red-500 text-white text-xs rounded-full px-1">3</span>  
                     </a>  
                  </span>
               </div>
            </div>
         </div>

         <div class="parallax-foreground-magaza">
               <h1>Et & Hayat</h1>
         </div>

        </section>
    </section>

   <section class="magaza">
      <div class="magaza-place">
         <div class="left-menu">
            <h1>Filtrele</h1>
            <div class="left-menu-elements">
               <h3>Kategori</h3>
               <h3 id="hepsi">Hepsi</h3>
               <h3 id="dana">Dana</h3>
               <h3 id="beyaz">Beyaz Et</h3>
               <h3 id="kuzu">Kuzu</h3>
               <h3 id="dry">Dry</h3>
               <h3 id="izgaralar">Izgaralar</h3>
            </div>
         </div>
   
         <div class="right-visuals">
            <div class="visual-group" id="product-container">
               <div class="visual1">
                  <img src="../img/kirmiziEtUrunleri/antrikot.png" alt="Ürün-1" id="urun-1">
                  <div class="urun-name" id="urun-1-name" >Antrikot </div>
                  
                  <div class="price-container">
                     <p class="urun-1-price">780,00 </p>
                     <svg xmlns="http://www.w3.org/2000/svg" id="urun-price-sign" data-name="Layer 1" viewBox="0 0 24 24" width="5" height="20" class="tlSign">  
                        <path d="M20.5,11c-.829,0-1.5,.672-1.5,1.5,0,4.687-3.813,8.5-8.5,8.5-.827,0-1.5-.673-1.5-1.5v-5.403l6.013-2.186c.778-.283,1.18-1.145,.897-1.923-.283-.779-1.144-1.181-1.922-.897l-4.987,1.814v-1.807l6.013-2.186c.778-.283,1.18-1.145,.897-1.923-.283-.779-1.144-1.181-1.922-.897l-4.987,1.814V1.5c-.034-1.972-2.967-1.971-3,0V6.994l-3.013,1.096c-.778,.283-1.18,1.145-.897,1.923,.282,.787,1.164,1.177,1.922,.897l1.987-.723v1.807l-3.013,1.096c-.778,.283-1.18,1.145-.897,1.923,.282,.787,1.164,1.177,1.922,.897l1.987-.723v4.312c0,2.481,2.019,4.5,4.5,4.5,6.341,0,11.5-5.159,11.5-11.5,0-.828-.671-1.5-1.5-1.5Z"/>  
                     </svg>
                  </div>
   
                  <div class="addPlace" id="addPlaceMagaza">
                     <p class="minus-magaza" id="1minusMagaza">- </p>
                     <div class="quantity-group">
                        <p class="quantity-magaza" id="1quantityMagaza">1 </p>
                        <p class="kg-magaza" id="kgMagaza">kg </p>
                     </div>
                     <p class="plus-magaza" id="1plusMagaza">+ </p>
                  </div>
               
                     <button class="add-basket" id="addBasketMagaza">  
                        <p class="basketText">Sepete Ekle </p>  
                     </button>  
                  </div>
               </div>
            </div>
            
         </div>
      </div>
   </section>

   <section class="adv-area">
      <div class="adv-area-index">
         <img src="../img/magaza/adv1.png" alt="adv-1" id="adv1">
      </div>
      <div class="adv-area-text">
         <p>Kasapzakir'dan aldığım et ürünleri gerçekten <br>taze ve lezzetli, 30 yıllık deneyimlerini<br> hissediyorsunuz.</p>
         <img src="../img/parallax-2/user3.png" alt="user3" class="user3">
         <p>Cemile U.</p>
      </div>
   </section>

   <!-- Modal -->  
   <div id="myModalMagaza" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden">  
      <div class="bg-white rounded-lg shadow-lg w-[800px] p-6">  
         <h4 class="text-xl font-semibold mb-4">Bilgi</h4>  
         <div class="space-y-4 text-gray-700">  
               <div>  
                  <h5 class="font-semibold">Ürün Eklendi.</h5>  
                  <p>Seçilen ürünler sepete eklenmiştir. Seçmiş olduğunuz tüm ürünleri sepet menüsünden görüntüleyebilirsiniz.</p>  
               </div>  
         </div>  
         <button onclick="closeInfoMenu()" class="mt-4 bg-blue-500 text-white font-semibold py-2 px-4 rounded hover:bg-blue-600">Kapat</button>  
      </div>  
   </div>
      
    <footer>
        <section class="info">
           <div class="info-title">
              <div class="left">
                 <span>
                    <h3>Kalite</h3>
                 </span>
                 <span>
                    <h2>Doğal ve sağlıklı et ürünleri sunuyoruz.</h2>
                 </span>
                 <span>
                    <i class="fa-brands fa-square-x-twitter"></i>
                    <i class="fa-brands fa-square-instagram"></i>
                    <i class="fa-brands fa-square-facebook"></i>
                 </span>
                 <div class="ttSoft">
                    <h1>TTsoft© 2024. All rights reserved.</h1>
                 </div>  
              </div>
  
              <div class="center">
                 <h3>ADRES</h3>
                 <iframe class="frame" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d762.8812794954108!2d27.651326599999997!3d40.1082996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14b693fdbc468beb%3A0xb2c0207f2a4528d5!2sKasap%20Zakir!5e0!3m2!1str!2str!4v1725693718240!5m2!1str!2str"
                    width="300" 
                    height="200" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                 </iframe>
                 <span>
                    <h2>Kurtuluş Mahallesi, Hüseyin Tümer <br>Caddesi No:32/c Gönen, Balıkesir</h2>
                 </span>
              </div>
              
              <div class="right">
                 <h3>İLETİŞİM</h3>
                 <div class="rightTel1">
                    <h2>0 266 762 3300</h2>
                 </div>
                 <div class="rightTel2">
                    <h2>0 540 762 3300</h2>
                 </div>
                 <div class="rightEmail"></div>
                    <h2>bilgi@kasapzakir.shop</h2>
                 </div>
              </div>
           </div>
        </section>
     </footer>

    <script src="../js/circleUser.js"></script>
    <script src="../js/scroll.js"></script>
    <script src="../js/bold.js"></script>
    <script type="module" src="/js/quantityIndex.js"></script>
    <script src="../js/addNewProduct.js"></script>
    <script type="module">  
      import { setupProductButtons } from '../js/products.js';  
      const urlParams = new URLSearchParams(window.location.search);  
      const product = urlParams.get('product');  
      
      let initialProductGroup = 'dana'; // Varsayılan değer  

      if (product === 'beyaz') {  
         initialProductGroup = 'beyaz';  
      } else if (product === 'dry') {  
         initialProductGroup = 'dry';  
      } else if (product === 'izgaralar') {  
         initialProductGroup = 'izgaralar';  
      }  
      
      setupProductButtons(initialProductGroup);  
   </script>
   <script type="module">
      import { writeLength } from '/js/readIndexDb.js';
      writeLength();
      
   </script>
   <script>
      function closeInfoMenu() {  
         document.getElementById('myModalMagaza').classList.remove('sekil');  
         document.getElementById('myModalMagaza').classList.add('hidden');  
      } 
   </script>


</body>
</html>